# Copy this file to .env.prod locally. Never commit the resulting file.
HELIOS_SENTINEL_DDBB_URL=
HELIOS_SENTINEL_DDBB_USERNAME=
HELIOS_SENTINEL_DDBB_PASS=
HELIOS_SENTINEL_JWT_SECRET=
HELIOS_SENTINEL_ENCRYPTION_KEY=
HELIOS_SENTINEL_MAIL_HOST=smtp.gmail.com
HELIOS_SENTINEL_MAIL_PORT=587
HELIOS_SENTINEL_MAIL_USERNAME=
HELIOS_SENTINEL_MAIL_PASSWORD=
HELIOS_TELEGRAM_BOT_TOKEN=
HELIOS_TELEGRAM_CHAT_ID=
HELIOS_TELEGRAM_BOT_USERNAME=sentinel_bot
HELIOS_SENTINEL_REDIS_HOST=localhost
HELIOS_SENTINEL_REDIS_PORT=6379
HELIOS_SENTINEL_CACHE_TYPE=simple

# Disabled by default. Enable only for an audited, one-time bootstrap.
HELIOS_SENTINEL_BOOTSTRAP_ENABLED=false
HELIOS_SENTINEL_BOOTSTRAP_USERNAME=
HELIOS_SENTINEL_BOOTSTRAP_NAME=
HELIOS_SENTINEL_BOOTSTRAP_EMAIL=
HELIOS_SENTINEL_BOOTSTRAP_PASSWORD=
HELIOS_SENTINEL_BOOTSTRAP_ROLE=ROOT
HELIOS_SENTINEL_BOOTSTRAP_PERMISSIONS=ALL_PERMISSIONS
